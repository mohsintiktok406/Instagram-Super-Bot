APP_ENV=development
VERIFY_TOKEN=replace-with-a-long-random-token
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
GRAPH_API_VERSION=v24.0
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
ALLOWED_SENDER_IDS=
DATABASE_PATH=data/instagram_super_bot.sqlite3

# Ordinary attachment handling + disappearing-media metadata classification are disabled by default.
# This flag does not enable View Once archiving.
VIEW_ONCE_ENABLED=false
# Logs a redacted attachment-payload structure (never message text or signed URLs).
VIEW_ONCE_DEBUG_RAW=false
# Ordinary, non-disappearing attachment retention. 0 disables purge.
VIEW_ONCE_RETENTION_DAYS=30
MEDIA_MAX_BYTES=15728640
